From d40daa1f9436d07e8d2d959828448eff64e4898c Mon Sep 17 00:00:00 2001
From: ysrdevs <singh.yuvraj31@icloud.com>
Date: Sat, 24 Oct 2026 04:14:04 -0500
Subject: [PATCH] macOS: retry hook transactions when threads exit

---
 src/dll/Platform/NativeHook.cpp | 65 +++++++++++++++++++++++----------
 tests/native_hook/main.cpp      | 51 ++++++++++++++++++++++++++
 2 files changed, 96 insertions(+), 20 deletions(-)

diff --git a/src/dll/Platform/NativeHook.cpp b/src/dll/Platform/NativeHook.cpp
index 3c73e4d..965c629 100644
--- a/src/dll/Platform/NativeHook.cpp
+++ b/src/dll/Platform/NativeHook.cpp
@@ -683,18 +683,18 @@ uint64_t CurrentThreadId()
     return id;
 }
 
-void FinishThreads(thread_act_array_t threads, mach_msg_type_number_t count, uint64_t selfId, bool resume)
+void FinishThreads(thread_act_array_t threads, mach_msg_type_number_t count, const bool* suspended)
 {
     if (threads == nullptr)
     {
         return;
     }
 
-    if (resume)
+    if (suspended != nullptr)
     {
         for (mach_msg_type_number_t i = 0; i < count; ++i)
         {
-            if (ThreadId(threads[i]) != selfId)
+            if (suspended[i])
             {
                 thread_resume(threads[i]);
             }
@@ -1044,6 +1044,19 @@ bool StopAndPatch(Site** sites, uint32_t siteCount)
     }
 
     const uint64_t selfId = CurrentThreadId();
+    if (selfId == 0)
+    {
+        return false;
+    }
+    const auto retry = [](int attempt)
+    {
+        if (attempt + 1 == kPcRetries)
+        {
+            return false;
+        }
+        usleep(static_cast<useconds_t>(1000u * static_cast<useconds_t>(attempt + 1)));
+        return true;
+    };
     for (int attempt = 0; attempt < kPcRetries; ++attempt)
     {
         thread_act_array_t threads = nullptr;
@@ -1055,27 +1068,36 @@ bool StopAndPatch(Site** sites, uint32_t siteCount)
 
         if (count > kMaxThreads)
         {
-            FinishThreads(threads, count, selfId, false);
+            FinishThreads(threads, count, nullptr);
             return false;
         }
 
         uint64_t ids1[kMaxThreads]{};
+        bool suspendedThreads[kMaxThreads]{};
         bool suspended = true;
         for (mach_msg_type_number_t i = 0; i < count; ++i)
         {
             ids1[i] = ThreadId(threads[i]);
-            if (ids1[i] != selfId)
+            if (ids1[i] == 0)
             {
-                if (thread_suspend(threads[i]) != KERN_SUCCESS)
-                {
-                    suspended = false;
-                }
+                suspended = false;
+            }
+            else if (ids1[i] != selfId)
+            {
+                suspendedThreads[i] = thread_suspend(threads[i]) == KERN_SUCCESS;
+                suspended = suspended && suspendedThreads[i];
             }
         }
 
         if (!suspended)
         {
-            FinishThreads(threads, count, selfId, true);
+            // A thread may exit after task_threads, even after pthread_join.
+            // Release this snapshot and retry before writing any code.
+            FinishThreads(threads, count, suspendedThreads);
+            if (retry(attempt))
+            {
+                continue;
+            }
             return false;
         }
 
@@ -1089,11 +1111,12 @@ bool StopAndPatch(Site** sites, uint32_t siteCount)
             for (mach_msg_type_number_t i = 0; i < count2; ++i)
             {
                 ids2[i] = ThreadId(threads2[i]);
+                same = same && ids2[i] != 0;
             }
 
             std::sort(ids1, ids1 + count);
             std::sort(ids2, ids2 + count2);
-            same = std::memcmp(ids1, ids2, count * sizeof(uint64_t)) == 0;
+            same = same && std::memcmp(ids1, ids2, count * sizeof(uint64_t)) == 0;
         }
 
         if (threads2 != nullptr)
@@ -1108,14 +1131,18 @@ bool StopAndPatch(Site** sites, uint32_t siteCount)
 
         if (!same)
         {
-            FinishThreads(threads, count, selfId, true);
+            FinishThreads(threads, count, suspendedThreads);
+            if (retry(attempt))
+            {
+                continue;
+            }
             return false;
         }
 
         bool hot = false;
         for (mach_msg_type_number_t i = 0; i < count; ++i)
         {
-            if (ThreadId(threads[i]) == selfId)
+            if (!suspendedThreads[i])
             {
                 continue;
             }
@@ -1160,18 +1187,16 @@ bool StopAndPatch(Site** sites, uint32_t siteCount)
 
         if (hot)
         {
-            FinishThreads(threads, count, selfId, true);
-            if (attempt + 1 == kPcRetries)
+            FinishThreads(threads, count, suspendedThreads);
+            if (retry(attempt))
             {
-                return false;
+                continue;
             }
-
-            usleep(static_cast<useconds_t>(1000u * static_cast<useconds_t>(attempt + 1)));
-            continue;
+            return false;
         }
 
         const bool patched = PatchSites(sites, siteCount, hotPages, hotCount);
-        FinishThreads(threads, count, selfId, true);
+        FinishThreads(threads, count, suspendedThreads);
         return patched;
     }
 
diff --git a/tests/native_hook/main.cpp b/tests/native_hook/main.cpp
index 0b3be74..f356656 100644
--- a/tests/native_hook/main.cpp
+++ b/tests/native_hook/main.cpp
@@ -331,11 +331,61 @@ static void TestParked(bool hookSpinner)
         CHECK(reinterpret_cast<int (*)(int)>(page)(1) == 2);
     }
 
+    if (committed)
+    {
+        Tx detach;
+        CHECK(NativeHook::Detach(&slot, reinterpret_cast<void*>(ParkForward)) == 0);
+        CHECK(detach.Commit());
+    }
+    CHECK(slot == (hookSpinner ? reinterpret_cast<void*>(spin) : page));
+
     mach_vm_deallocate(mach_task_self(), reinterpret_cast<mach_vm_address_t>(page),
                        static_cast<mach_vm_size_t>(vm_page_size));
     std::printf("PASS park %s\n", hookSpinner ? "inside" : "same-page");
 }
 
+static void* ExitThread(void*)
+{
+    return nullptr;
+}
+
+static void TestExitingThreads()
+{
+    // pthread_join may return while the kernel thread is still terminating.
+    // A hook transaction must retry that stale snapshot before touching code.
+    for (int i = 0; i < 128; ++i)
+    {
+        pthread_t thread{};
+        const int created = pthread_create(&thread, nullptr, ExitThread, nullptr);
+        CHECK(created == 0);
+        if (created != 0)
+        {
+            return;
+        }
+        CHECK(pthread_join(thread, nullptr) == 0);
+
+        void* slot = reinterpret_cast<void*>(TextTarget);
+        const bool hooked = Hook(&slot, reinterpret_cast<void*>(TextDetour));
+        CHECK(hooked);
+        if (!hooked)
+        {
+            CHECK(slot == reinterpret_cast<void*>(TextTarget));
+            CHECK(TextTarget(1) == 2);
+            continue;
+        }
+        CHECK(TextTarget(1) == 42);
+        CHECK(reinterpret_cast<int (*)(int)>(slot)(1) == 2);
+        {
+            Tx detach;
+            CHECK(NativeHook::Detach(&slot, reinterpret_cast<void*>(TextDetour)) == 0);
+            CHECK(detach.Commit());
+        }
+        CHECK(slot == reinterpret_cast<void*>(TextTarget));
+        CHECK(TextTarget(1) == 2);
+    }
+    std::printf("PASS exiting threads\n");
+}
+
 static void TestHookStats()
 {
     CHECK(TextTarget(1) == 2);
@@ -900,6 +950,7 @@ int main()
     TestOutOfRange();
     TestParked(false);
     TestParked(true);
+    TestExitingThreads();
     TestHookStats();
     TestFarPatch();
     TestFarChain();

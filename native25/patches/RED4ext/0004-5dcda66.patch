From 5dcda66e994ff0371a6d6e97b348b09e832eb580 Mon Sep 17 00:00:00 2001
From: ysrdevs <singh.yuvraj31@icloud.com>
Date: Sat, 24 Oct 2026 04:50:30 -0500
Subject: [PATCH] macOS: report exhausted hook allocation windows

---
 src/dll/Platform/NativeHook.cpp | 55 +++++++++++++++++++++++++++++++--
 1 file changed, 52 insertions(+), 3 deletions(-)

diff --git a/src/dll/Platform/NativeHook.cpp b/src/dll/Platform/NativeHook.cpp
index 3538814..747a7be 100644
--- a/src/dll/Platform/NativeHook.cpp
+++ b/src/dll/Platform/NativeHook.cpp
@@ -364,6 +364,19 @@ bool AllocateWindow(uintptr_t target, uint8_t** out, uintptr_t limit, int maxSte
     const uintptr_t lo = target > limit ? target - limit : page;
     uintptr_t cursor = (lo + page - 1) & ~(page - 1);
     const uintptr_t hi = target + limit;
+    struct AllocationAttempt
+    {
+        uintptr_t candidate;
+        uintptr_t gapEnd;
+        int kr;
+    };
+    AllocationAttempt attempts[16]{};
+    uint32_t attemptCount = 0;
+    AllocationAttempt lastAttempt{};
+    uintptr_t lastRegion = 0;
+    uintptr_t lastRegionEnd = 0;
+    int lastRegionKr = 0;
+    int steps = 0;
 
     for (int n = 0; n < maxSteps && cursor < hi; ++n)
     {
@@ -374,12 +387,23 @@ bool AllocateWindow(uintptr_t target, uint8_t** out, uintptr_t limit, int maxSte
         mach_port_t object = MACH_PORT_NULL;
         const kern_return_t kr = mach_vm_region(mach_task_self(), &region, &regionSize, VM_REGION_BASIC_INFO_64,
                                                 reinterpret_cast<vm_region_info_t>(&info), &count, &object);
+        ++steps;
+        lastRegion = region;
+        lastRegionEnd = region + regionSize;
+        lastRegionKr = kr;
         const mach_vm_address_t gapEnd = kr == KERN_SUCCESS ? region : hi;
         const mach_vm_address_t capped = gapEnd > hi ? hi : gapEnd;
         if (capped > cursor && capped - cursor >= page)
         {
             mach_vm_address_t hint = cursor;
-            if (mach_vm_allocate(mach_task_self(), &hint, page, VM_FLAGS_FIXED) == KERN_SUCCESS)
+            const auto allocationKr = mach_vm_allocate(mach_task_self(), &hint, page, VM_FLAGS_FIXED);
+            lastAttempt = {cursor, static_cast<uintptr_t>(capped), allocationKr};
+            if (attemptCount < 16)
+            {
+                attempts[attemptCount] = lastAttempt;
+            }
+            ++attemptCount;
+            if (allocationKr == KERN_SUCCESS)
             {
                 const auto got = static_cast<uintptr_t>(hint);
                 if (adrp ? InAdrpRange(target, got) : InBranchRange(target, got))
@@ -406,6 +430,24 @@ bool AllocateWindow(uintptr_t target, uint8_t** out, uintptr_t limit, int maxSte
         cursor = static_cast<uintptr_t>(next);
     }
 
+    // Report only exhausted far searches. Successful hooks and near-to-far
+    // fallbacks stay quiet; this distinguishes denied gaps from a full window.
+    if (adrp)
+    {
+        std::fprintf(stderr, "[NativeHook] Far allocation window failed: target=0x%lx lo=0x%lx hi=0x%lx "
+                             "cursor=0x%lx steps=%d/%d gaps=%u last_region=0x%lx-0x%lx region_kr=%d\n",
+                     target, lo, hi, cursor, steps, maxSteps, attemptCount, lastRegion, lastRegionEnd, lastRegionKr);
+        for (uint32_t i = 0; i < std::min(attemptCount, 16u); ++i)
+        {
+            std::fprintf(stderr, "[NativeHook] Allocation gap: candidate=0x%lx end=0x%lx kr=%d\n",
+                         attempts[i].candidate, attempts[i].gapEnd, attempts[i].kr);
+        }
+        if (attemptCount > 16)
+        {
+            std::fprintf(stderr, "[NativeHook] Final allocation gap: candidate=0x%lx end=0x%lx kr=%d\n",
+                         lastAttempt.candidate, lastAttempt.gapEnd, lastAttempt.kr);
+        }
+    }
     return false;
 }
 
@@ -419,7 +461,8 @@ bool AllocateFar(uintptr_t target, uint8_t** out)
 {
     const uintptr_t page = PageSize();
     mach_vm_address_t hint = 0;
-    if (mach_vm_allocate(mach_task_self(), &hint, page, VM_FLAGS_ANYWHERE) == KERN_SUCCESS)
+    const auto anywhereKr = mach_vm_allocate(mach_task_self(), &hint, page, VM_FLAGS_ANYWHERE);
+    if (anywhereKr == KERN_SUCCESS)
     {
         if (InAdrpRange(target, static_cast<uintptr_t>(hint)))
         {
@@ -432,7 +475,13 @@ bool AllocateFar(uintptr_t target, uint8_t** out)
 
     // ponytail: ANYWHERE missed the ±4GiB ADRP window; walk gaps inside it.
     const uintptr_t limit = (static_cast<uintptr_t>(1) << 32) - page;
-    return AllocateWindow(target, out, limit, 16384, true);
+    const bool allocated = AllocateWindow(target, out, limit, 16384, true);
+    if (!allocated)
+    {
+        std::fprintf(stderr, "[NativeHook] Far ANYWHERE attempt: target=0x%lx result=0x%llx kr=%d reachable=%d\n",
+                     target, hint, anywhereKr, InAdrpRange(target, static_cast<uintptr_t>(hint)));
+    }
+    return allocated;
 }
 
 bool TryEncodeAdrp(uint64_t pc, uint64_t page, uint32_t rd, uint32_t* out)

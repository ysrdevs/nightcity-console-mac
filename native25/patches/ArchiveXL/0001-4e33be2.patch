From 4e33be24dcf0ac6bbcda9141054c316bc1ae1773 Mon Sep 17 00:00:00 2001
From: ysrdevs <singh.yuvraj31@icloud.com>
Date: Sat, 24 Oct 2026 04:06:54 -0500
Subject: [PATCH] macOS: preserve staged ArchiveXL scripts across launches

---
 src/App/Application.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/App/Application.cpp b/src/App/Application.cpp
index 1554e2a..8027ad9 100644
--- a/src/App/Application.cpp
+++ b/src/App/Application.cpp
@@ -97,5 +97,10 @@ void App::Application::OnStarting()
     LogInfo("{} {} is starting...", Project::Name, Project::Version.to_string());
 
     Migration::CleanUp(Env::LegacyBundleDir());
+#if defined(_WIN32) || defined(_WIN64)
     Migration::CleanUp(Env::LegacyScriptsDir());
+#else
+    // macOS launchers may compile their staged r6/scripts sources with scc before
+    // starting the game. Keep that source tree intact across subsequent launches.
+#endif
 }

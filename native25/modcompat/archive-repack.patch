+static bool IsHashNamedRenderResource(string path)
+{
+    if (!path.EndsWith(".bin", StringComparison.OrdinalIgnoreCase) ||
+        !ulong.TryParse(Path.GetFileNameWithoutExtension(path), out _)) return false;
+    using var stream = File.OpenRead(path);
+    if (stream.Length < 4) return false;
+    using var reader = new CR2WReader(stream);
+    if (reader.ReadFileInfo(out var info) != ArchiveErr.NoError || info == null || info.ExportInfo.Length == 0)
+        return false;
+    var rootType = info.StringDict[info.NameInfo[info.ExportInfo[0].className].offset];
+    return rootType is "CMesh" or "MorphTargetMesh";
+}

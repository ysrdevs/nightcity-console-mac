+          "name": "GetActiveItem",
+          "before_token_sha256": "30532f1bab45a32d1e4e362a884b094d8aae55d3c6121b0ee1955ed29dae2e9c",
+          "after_token_sha256": "05890a8948e95cf58a2e70c63bc81dcd96b2e3ec456bc82de1e9cc7d440a3549",
+          "replacement": "@wrapMethod(EquipmentSystemPlayerData)\npublic final const func GetActiveItem(equipArea: gamedataEquipmentArea, opt isLeftHandWeapon: Bool) -> ItemID {\n    if Equals(equipArea, gamedataEquipmentArea.SystemReplacementCW) {\n        return this.GetTaggedItem(equipArea, n\"Cyberdeck\");\n    }\n\n    // Game 2.5 uses this flag to resolve the active left-hand weapon. Preserve\n    // the game's selection for every area outside the mod's cyberdeck lookup.\n    return wrappedMethod(equipArea, isLeftHandWeapon);\n}"
+        },
+        {
+          "name": "UpdateArmSlot",
+          "before_token_sha256": "b28b9ac9d487ae78aab50525253107d1d60b8a40029db89cc6e3781b07d73897",
+          "after_token_sha256": "766cf4445eb8cedcf326f07599282b7415c4f5a73f3a56c5d20f9d7c5a70e603",
+          "replacement": "@if(!ModuleExists(\"CyberarmOverhaul\"))\n@wrapMethod(EquipmentSystemPlayerData)\npublic final static func UpdateArmSlot(owner: ref<gamePuppet>, itemToDraw: ItemID, equipHolsteredItem: Bool) {\n    // The 2.5 method also accepts non-player puppets. Keep their original game\n    // behavior, while retaining Cyberware-EX's player and Johnny handling.\n    let player = owner as PlayerPuppet;\n    if !IsDefined(player) {\n        wrappedMethod(owner, itemToDraw, equipHolsteredItem);\n        return;\n    }\n    if !ItemID.IsValid(itemToDraw) || player.IsJohnnyReplacer() {\n      return;\n    }\n\n    let equipmentData = EquipmentSystem.GetData(owner);\n\n    if !IsDefined(equipmentData) {\n      return;\n    }\n\n    let transactionSystem = GameInstance.GetTransactionSystem(owner.GetGame());\n    let rightWeapon = transactionSystem.GetItemInSlot(owner, t\"AttachmentSlots.WeaponRight\");\n    let leftWeapon = transactionSystem.GetItemInSlot(owner, t\"AttachmentSlots.WeaponLeft\");\n    let rightRecord: wref<Item_Record>;\n    let leftRecord: wref<Item_Record>;\n    if IsDefined(rightWeapon) {\n        rightRecord = TweakDBInterface.GetItemRecord(ItemID.GetTDBID(rightWeapon.GetItemID()));\n    }\n    if IsDefined(leftWeapon) {\n        leftRecord = TweakDBInterface.GetItemRecord(ItemID.GetTDBID(leftWeapon.GetItemID()));\n    }\n\n    let cyberArmsInUse = IsDefined(rightRecord) && rightRecord.TagsContains(n\"Meleeware\");\n    let launcherInUse = IsDefined(leftRecord) && leftRecord.TagsContains(n\"ProjectileLauncher\");\n\n    let meleeWareID = ItemID.None();\n    let slotIndex = 0;\n    let equipAreaIndex = equipmentData.GetEquipAreaIndex(gamedataEquipmentArea.ArmsCW);\n    if equipAreaIndex < 0 || equipAreaIndex >= ArraySize(equipmentData.m_equipment.equipAreas) {\n        return;\n    }\n    let numberOfSlots = ArraySize(equipmentData.m_equipment.equipAreas[equipAreaIndex].equipSlots);\n    while slotIndex < numberOfSlots {\n        let itemID = equipmentData.m_equipment.equipAreas[equipAreaIndex].equipSlots[slotIndex].itemID;\n        if ItemID.IsValid(itemID) {\n            meleeWareID = itemID;\n            let itemRecord = TweakDBInterface.GetItemRecord(ItemID.GetTDBID(itemID));\n            if IsDefined(itemRecord) && !itemRecord.TagsContains(n\"ProjectileLauncher\") {\n                break;\n            }\n        }\n        slotIndex += 1;\n    }\n\n    if !ItemID.IsValid(meleeWareID) {\n        meleeWareID = equipmentData.GetBaseFistsItemID();\n    }\n\n    if !launcherInUse && !cyberArmsInUse {\n        let meleeWareRecord = TweakDBInterface.GetWeaponItemRecord(ItemID.GetTDBID(meleeWareID));\n        if !IsDefined(meleeWareRecord) || !IsDefined(meleeWareRecord.HolsteredItem()) {\n            return;\n        }\n        let holsteredArmsID = ItemID.CreateQuery(meleeWareRecord.HolsteredItem().GetID());\n        if !ItemID.IsValid(holsteredArmsID) {\n            return;\n        }\n\n        if !transactionSystem.HasItem(owner, holsteredArmsID) {\n            transactionSystem.GiveItem(owner, holsteredArmsID, 1);\n        }\n\n        EquipmentSystemPlayerData.ForceQualityAndDuplicateStatsShard(owner, meleeWareID, holsteredArmsID);\n\n        if !equipmentData.IsEquipped(holsteredArmsID) {\n            equipmentData.EquipItem(holsteredArmsID, false, false);\n        }\n    } else {\n        equipmentData.UnequipItem(equipmentData.GetEquipAreaIndex(gamedataEquipmentArea.RightArm), 0, true);\n    }\n}"
+        }
